# ============================================================
# Application
# ============================================================
APP_ENV=local
APP_PORT=8002
LOG_LEVEL=INFO

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_DB=parsing_ai
POSTGRES_USER=parsing_user
POSTGRES_PASSWORD=parsing_password
DATABASE_URL=postgresql+psycopg://parsing_user:parsing_password@postgres:5432/parsing_ai

# ============================================================
# RabbitMQ
# ============================================================
RABBITMQ_DEFAULT_USER=parsing
RABBITMQ_DEFAULT_PASS=parsing
CELERY_BROKER_URL=amqp://parsing:parsing@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# Qdrant
# ============================================================
QDRANT_URL=http://qdrant:6333

# ============================================================
# AI provider (DeepSeek API, OpenAI-compatible)
# ============================================================
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ============================================================
# Embeddings (external API, provider not chosen yet)
# ============================================================
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
